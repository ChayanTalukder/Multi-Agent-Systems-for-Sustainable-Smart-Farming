	series = {Lecture {Notes} in {Computer} {Science} (including subseries {Lecture} {Notes} in {Artificial} {Intelligence} and {Lecture} {Notes} in {Bioinformatics})},
	title = {The {MAELIA} {Multi}-agent platform for integrated analysis of interactions between agricultural land-use and low-water management strategies},
	volume = {8235},
	isbn = {03029743 (ISSN); 978-364254782-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/84958521272?origin=resultslist},
	doi = {10.1007/978-3-642-54783-6_6},
	abstract = {The MAELIA project is developing an agent-based modeling and simulation platform to study the environmental, economic and social impacts of various regulations regarding water use and water management in combination with climate change. It is applied to the case of the French Adour-Garonne Basin, which is the most concerned in France by water scarcity during the low-water period. An integrated approach has been chosen to model this social-ecological system: the model combines spatiotemporal models of ecologic (e.g. rainfall and temperature changes, water flow and plant growth) and socio-economic (e.g. farmer decision-making process, management of low-water flow, demography, land use and land cover changes) processes and sub-models of cognitive sharing among agents (e.g. weather forecast, normative constraints on behaviors). © Springer-Verlag Berlin Heidelberg 2014.},
