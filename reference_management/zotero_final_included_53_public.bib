}

@inproceedings{agyeman_semi-centralized_2024,
	title = {Semi-centralized {Multi}-agent {RL} for {Irrigation} {Scheduling}},
	volume = {58},
	isbn = {24058971 (ISSN)},
	url = {https://www.scopus.com/pages/publications/85203283304?origin=resultslist},
	doi = {10.1016/j.ifacol.2024.08.328},
	abstract = {This study proposes a Semi-centralized Multi-agent Reinforcement Learning (SCMARL) approach for irrigation scheduling in agricultural fields, which are characterized by spatial variability and therefore delineated into management zones. The SCMARL framework is hierarchical in nature, with a coordinator agent at the top level and local agents at the second/lower level. The coordinator agent makes daily 'yes/no' irrigation decisions based on field-wide observations from all the management zones, which are then communicated to local agents. These local agents are tasked with determining the optimal daily irrigation depths for specific management zones, utilizing both the coordinator agent's decision and local observations. A comparison between the SCMARL method and a Fully Decentralized Multi-agent Reinforcement Learning approach is presented, highlighting the superior performance of the SCMARL approach in terms of water savings and improved irrigation water-use efficiency. Copyright © 2024 The Authors.},
	language = {English},
	number = {14},
	booktitle = {{IFAC}-{PapersOnLine}},
	publisher = {Elsevier B.V.},
	author = {Agyeman, B.T. and Liu, J. and Shah, S.L.},
	year = {2024},
	keywords = {Centralised, Federated learning, irrigation scheduling, Irrigation scheduling, Management zones, Mixed integer, Mixed-integer linear programming, mixed-integer optimal control, Mixed-integer optimal control, Multi-agent reinforcement learning, Optimal controls, Reinforcement learning, Reinforcement learning approach, S23, semi-centralized multi-agent reinforcement learning, Semi-centralized multi-agent reinforcement learning, SF08, Subirrigation},
	pages = {145--150},
}

@inproceedings{gonzalez-briones_intelligent_2019,
	title = {Intelligent multi-agent system for water reduction in automotive irrigation processes},
	volume = {151},
	isbn = {18770509 (ISSN)},
	url = {https://www.scopus.com/pages/publications/85071932581?origin=resultslist},
	doi = {10.1016/j.procs.2019.04.136},
	abstract = {This paper deals with a multi-agent system (MAS) to automate the gathering and managing of information from potato crops in order to provide a precision irrigation system. The proposal and development of a novel MAS is presented based on different agent subsystems with specific objectives to meet the main objective of the global MAS. The proposed MAS has been developed on the Cloud Computing paradigm and is able to gather data from wireless sensor networks (WSNs) located in potato crops for knowledge discovery and decision making. According to the collected information as historical data by the MAS, it can make decision on an actuator set that modify the irrigation system by updating the areas of the crop with most irrigation needs. The use of these intelligent technologies in rural areas provides a considerable saving of resources and improves the efficiency and effectiveness of agricultural production systems. The architecture has been tested in an agricultural environment in order to optimize irrigation in a potato crop. The results showed a significant reduction in comparison to traditional automotive irrigation. © 2019 The Authors. Published by Elsevier B.V.},
	language = {English},
	booktitle = {Procedia {Computer} {Science}},
	publisher = {Elsevier B.V.},
	author = {González-Briones, A. and Mezquita, Y. and Castellanos-Garzón, J.A. and Prieto, J. and Corchado, J.M.},
	year = {2019},
	keywords = {Agricultural environments, Agricultural production system, Agricultural robots, CBR system, CBR systems, Crops, Decision making, Industry 4.0, Intelligent agents, Intelligent multi agent systems, Intelligent technology, Irrigation, Multi agent systems, Multi-agent system, Pivot irrigation, Precision irrigation, Radio frequency identification (RFID), RFID, S24, SF24, Smart sprinkling, Wireless sensor network (WSNs), Wireless sensor networks},
	pages = {971--976},
}

