	year = {2014},
	keywords = {Agent-based model, Agent-based modeling and simulation, Climate change, Computational methods, Computer simulation, Decision making process, Economic and social effects, Economics, Environmental regulations, Flow of water, Hydraulics, Integrated assessment, Integrated assessment and modeling, Land use, Land use and land cover change, Management strategies, S22, SF13, Social-ecological systems, Spatio-temporal models, Water management, Weather forecasting},
